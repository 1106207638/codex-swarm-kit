{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Worker Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "task_id", "goal", "task", "standard"],
  "properties": {
    "protocol": {"const": "local-worker/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
    "task": {
      "type": "object", "additionalProperties": false, "required": ["kind", "instruction", "items"],
      "properties": {
        "kind": {"enum": ["classify", "extract", "translate", "summarize"]},
        "instruction": {"type": "string", "minLength": 1},
        "items": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/item"}},
        "labels": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true,
                   "items": {"type": "string", "minLength": 1}},
        "fields": {
          "type": "object", "minProperties": 1, "maxProperties": 16,
          "additionalProperties": {"$ref": "#/$defs/field"}
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "classify"}}}, "then": {"required": ["labels"]}, "else": {"not": {"required": ["labels"]}}},
        {"if": {"properties": {"kind": {"const": "extract"}}}, "then": {"required": ["fields"]}, "else": {"not": {"required": ["fields"]}}},
        {"if": {"properties": {"kind": {"const": "translate"}}}, "else": {"properties": {"items": {"items": {"not": {"required": ["keep"]}}}}}}
      ]
    },
    "standard": {
      "type": "object", "additionalProperties": false, "required": ["criteria"],
      "properties": {
        "criteria": {"type": "array", "minItems": 1, "maxItems": 8,
                     "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "checks": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/check"}}
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "keep": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["type", "nullable"],
      "properties": {"type": {"enum": ["string", "integer", "boolean"]}, "nullable": {"type": "boolean"}}
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "item_id", "op"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "item_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "op": {"enum": ["equals", "contains", "source_quote"]},
        "expected": {"type": ["string", "integer", "boolean", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "source_quote"}}}, "then": {"not": {"required": ["expected"]}}, "else": {"required": ["expected"]}},
        {"if": {"properties": {"op": {"const": "contains"}}}, "then": {"properties": {"expected": {"type": "string", "minLength": 1, "maxLength": 512}}}}
      ]
    }
  }
}
